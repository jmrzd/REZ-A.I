# ONLY for deploy/deepseek-harness/compose.public.yaml.
# Copy to .env on the REMOTE server; never commit the real values.
# Create the DNS A/AAAA record for this domain before launching HTTPS.
DSH_DOMAIN=agent.example.org
DSH_BASIC_AUTH_USER=rezadmin
# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-unique-long-password'
# Store only the hash here. If the hash contains $, escape it as $$ for Docker Compose.
DSH_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_BCRYPT_HASH
