# Modelo local: instalar Ollama e executar ollama pull qwen3:1.7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# Modo nuvem é opcional. NUNCA publique .env!
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Modelo principal (Kimi K3): gere sua chave em platform.kimi.ai
# Nunca coloque esta chave no frontend ou em um commit.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
